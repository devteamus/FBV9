# ── Secrets — NEVER commit these ────────────────────────
.env
.env.*
!.env.example

# ── Dependencies ─────────────────────────────────────────
node_modules/
web/node_modules/
worker/node_modules/

# ── Build output ─────────────────────────────────────────
web/.next/
worker/dist/

# ── Prisma ───────────────────────────────────────────────
**/prisma/*.db
**/prisma/migrations/dev.db*

# ── Uploaded / user data (persisted via Docker volume, not git) ──
web/uploads/
uploads/

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / editor junk ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Local dev override (keep local, don't ship to Coolify) ──
docker-compose.override.yml
