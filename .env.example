# ═══════════════════════════════════════════════════════════
# FB Auto-Poster v2 — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# docker-compose will refuse to boot without required vars.
#
# Generate secrets:
#   openssl rand -base64 32          # JWT_SECRET
#   openssl rand -base64 32          # ENCRYPTION_KEY (must decode to exactly 32 bytes)
#
# ═══════════════════════════════════════════════════════════

# ── Required (no defaults) ──────────────────────────────
POSTGRES_PASSWORD=change_me_to_a_strong_password
JWT_SECRET=change_me_to_a_random_string_min_32_chars
ENCRYPTION_KEY=change_me_base64_encoded_32_bytes

# ── Optional (have safe defaults) ───────────────────────
POSTGRES_USER=fbposter
POSTGRES_DB=fbposter
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_PORT=3000
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000

# ── Worker tuning ──────────────────────────────────────
# v2.3 defaults are sized for the 1.5 GB dedicated-stack RAM budget
# (see docker-compose.yml for the full per-service budget table):
#   FAST  25 × 3 workers = 75 concurrent text/image posts
#   MEDIA  5 × 3 workers = 15 concurrent video/reel uploads
# Target scale (2,000 accounts, ≥1-minute intervals) needs < 50 due
# posts/min system-wide, so these already carry ~1.5× headroom.
# NOTE: the worker count is fixed at 3 by the compose file (Coolify
# replicas limitation) — changing it means editing docker-compose.yml.
FAST_QUEUE_CONCURRENCY=25
MEDIA_QUEUE_CONCURRENCY=5
VIDEO_UPLOAD_TIMEOUT_MS=480000
# Loopback port for the worker's Docker healthcheck (per worker)
WORKER_HEALTH_PORT=3999

# ── Limits (v2.2) ──────────────────────────────
# Max connected accounts per user (was 100, raised to 500).
# Keep in sync with the Redis maxmemory in docker-compose.yml when
# raising this — more accounts → more concurrent schedules → more
# delayed jobs living in Redis.
MAX_ACCOUNTS_PER_USER=500
# Max CSV upload size in BYTES (default 25 MB). Checked BEFORE the
# file is buffered into RAM — protects the web container (352 MB)
# from a single oversized request. Applies to both post CSVs and
# account-import CSVs.
MAX_CSV_BYTES=26214400
# Max .xlsx upload size in BYTES (default 25 MB). xlsx is parsed as a stream.
MAX_XLSX_BYTES=26214400

# ── Retention ──────────────────────────────────────────
MAX_CSV_ROWS=10000
MAX_CSV_COLUMNS=10000
# Upload throttles
UPLOAD_LIMIT_PER_HOUR=300
UPLOAD_INFLIGHT_BYTES=31457280
# Max scheduled (not yet published) posts system-wide; protects Redis (224 MB, noeviction)
MAX_PENDING_POSTS=150000
CSV_RETENTION_HOURS=24
JOB_RETENTION_DAYS=15

# ── Email / Forgot Password (Resend.com) ───────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender email on Resend (e.g. onboarding@yourdomain.com)
MAIL_FROM=onboarding@resend.dev
# Base URL of the app (used for links inside emails)
APP_BASE_URL=http://localhost:3000
